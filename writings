<div class="sound-btn" onclick="toggleAmbient()" title="Ambient sound"><span class="sound-icon" id="soundIcon">♪</span></div>

<script>
  function filterPosts(type){
    document.querySelectorAll('.filter-btn').forEach(b=>b.classList.remove('active'));
    event.target.classList.add('active');
    document.querySelectorAll('[data-type]').forEach(el=>{
      el.style.display=(type==='all'||el.dataset.type===type)?'block':'none';
    });
  }

  function openPost(id){
    document.getElementById('journalGrid').classList.add('hidden');
    document.getElementById('filterBar').classList.add('hidden');
    document.getElementById('listHeader').classList.add('hidden');
    document.querySelectorAll('.post-page').forEach(p=>p.classList.remove('active'));
    document.getElementById(id).classList.add('active');
    window.scrollTo({top:0,behavior:'smooth'});
  }

  function closePost(){
    document.querySelectorAll('.post-page').forEach(p=>p.classList.remove('active'));
    document.getElementById('journalGrid').classList.remove('hidden');
    document.getElementById('filterBar').classList.remove('hidden');
    document.getElementById('listHeader').classList.remove('hidden');
    window.scrollTo({top:0,behavior:'smooth'});
  }

  /* AMBIENT SOUND — birebir index.html ile aynı */
  let ambientAudio=null,ambientOn=false;
  function toggleAmbient(){
    if(ambientOn){
      if(ambientAudio)ambientAudio.pause();
      ambientOn=false;
      document.getElementById('soundIcon').style.color='var(--dim)';
    } else {
      ambientAudio=new Audio('/sigmaeffect-cinematic-ambient-atmosphere-463222.mp3');
      ambientAudio.loop=true;
      ambientAudio.volume=0.15;
      ambientAudio.play().catch(()=>{});
      ambientOn=true;
      document.getElementById('soundIcon').style.color='var(--accent)';
    }
  }
</script>
